# ============================================
# Court Access — Backend Environment Variables
# Copy to .env and fill in real values.
# ============================================

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI (AI analysis)
OPENAI_API_KEY=sk-...

# Cloudflare R2 (evidence storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=court-access-evidence
R2_PUBLIC_URL=

# Twilio SMS (subscription notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
ADMIN_ALERT_PHONE=+1XXXXXXXXXX

# ClamAV (virus scanning)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Sentry (error monitoring)
SENTRY_DSN=

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# Worker Configuration
WORKER_CONCURRENCY=3
WORKER_MAX_JOBS_PER_MIN=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
