// ---------------------------------------------------------------------------
// CPRA Policy Status Matrix — tracks policy status per agency per topic
// ---------------------------------------------------------------------------

model AgencyPolicyMatrix {
  id              String    @id @default(uuid())
  agencyId        String
  topicId         String
  status          String    @default("NOT_REQUESTED") // NOT_REQUESTED | REQUESTED | RECEIVED | UPLOADED | IN_USE
  requestDate     DateTime?
  receivedDate    DateTime?
  uploadedDate    DateTime?
  inUseDate       DateTime?
  fileUrl         String?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agencyId, topicId])
  @@index([agencyId])
  @@index([topicId])
  @@index([status])
  @@map("agency_policy_matrix")
}

// ---------------------------------------------------------------------------
// CPRA Request Tracking — outgoing CPRA requests per agency per topic
// ---------------------------------------------------------------------------

model CpraRequest {
  id                String    @id @default(uuid())
  agencyId          String
  topicId           String
  dateSent          DateTime?
  status            String    @default("draft") // draft | sent | awaiting_response | follow_up | documents_received | closed
  responseReceived  Boolean   @default(false)
  followupDate      DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([agencyId])
  @@index([topicId])
  @@index([status])
  @@map("cpra_requests_v2")
}

// ---------------------------------------------------------------------------
// AI Credit Balance — tracks monthly + purchased credits per user
// ---------------------------------------------------------------------------

model AiCreditBalance {
  id                  String    @id @default(uuid())
  userId              String    @unique
  monthlyCredits      Int       @default(0)
  purchasedCredits    Int       @default(0)
  creditsUsed         Int       @default(0)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([billingPeriodEnd])
  @@map("ai_credit_balances")
}

// ---------------------------------------------------------------------------
// AI Credit Usage — audit trail of every credit deduction
// ---------------------------------------------------------------------------

model AiCreditUsage {
  id              String    @id @default(uuid())
  userId          String
  caseId          String?
  analysisType    String    // VIDEO_PROCESSING | CONTRADICTION_ENGINE | DOCTRINE_ANALYSIS | LITIGATION_INTELLIGENCE | RELIABILITY_SCORING
  creditsUsed     Int
  timestamp       DateTime  @default(now())

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([caseId])
  @@index([analysisType])
  @@index([timestamp])
  @@map("ai_credit_usage")
}

// ---------------------------------------------------------------------------
// Usage Tracking — cumulative page + video usage per billing period
// ---------------------------------------------------------------------------

model UsageTracking {
  id                      String    @id @default(uuid())
  userId                  String
  organizationId          String?
  billingPeriodStart      DateTime
  billingPeriodEnd        DateTime
  pagesUploadedTotal      Int       @default(0)
  videoMinutesProcessed   Int       @default(0)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([userId, billingPeriodStart])
  @@index([userId])
  @@index([organizationId])
  @@index([billingPeriodEnd])
  @@map("usage_tracking")
}

// ---------------------------------------------------------------------------
// Autonomous CPRA System — Email Log (outbound + inbound)
// ---------------------------------------------------------------------------

model CpraEmailLog {
  emailId         String    @id @default(uuid())
  agencyId        String?
  direction       String    // OUTBOUND | INBOUND
  emailAddress    String
  fromAddress     String?
  subject         String
  body            String
  sentTimestamp   DateTime  @default(now())
  requestId       String?   // reference to CPRAAgencyRequest.requestId
  policyTopics    String?   // JSON array of requested policy topics
  sesMessageId    String?   // AWS SES message ID for outbound
  processed       Boolean   @default(false) // whether inbound email has been processed

  attachments     CpraEmailAttachment[]

  createdAt       DateTime  @default(now())

  @@index([agencyId])
  @@index([direction])
  @@index([requestId])
  @@index([processed])
  @@index([sentTimestamp])
  @@map("cpra_email_log")
}

// ---------------------------------------------------------------------------
// Autonomous CPRA System — Email Attachments
// ---------------------------------------------------------------------------

model CpraEmailAttachment {
  attachmentId    String    @id @default(uuid())
  emailId         String
  Email           CpraEmailLog @relation(fields: [emailId], references: [emailId])
  fileName        String
  fileType        String?   // application/pdf, image/png, etc.
  fileSizeBytes   Int?
  fileUrl         String?   // R2 URL after upload
  uploadTimestamp DateTime?
  documentType    String?   // policy_document | procedural_manual | training_bulletin | general_response | non_policy
  classificationConfidence Float?
  policyTopicDetected      String? // detected policy topic name
  processingStatus         String  @default("pending") // pending | uploaded | classified | ingested | failed

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([emailId])
  @@index([processingStatus])
  @@index([documentType])
  @@map("cpra_email_attachments")
}

// ---------------------------------------------------------------------------
// Autonomous CPRA System — Dashboard Notifications
// ---------------------------------------------------------------------------

model CpraNotification {
  notificationId  String    @id @default(uuid())
  agencyId        String?
  eventType       String    // EMAIL_SENT | EMAIL_RECEIVED | DOCUMENT_UPLOADED | POLICY_PARSED | POLICY_ACTIVE | FOLLOW_UP_SENT | REQUEST_CREATED
  title           String
  message         String
  metadata        String?   // JSON: additional event data
  read            Boolean   @default(false)
  dismissed       Boolean   @default(false)

  createdAt       DateTime  @default(now())

  @@index([agencyId])
  @@index([eventType])
  @@index([read])
  @@index([createdAt])
  @@map("cpra_notifications")
}

// ---------------------------------------------------------------------------
// Autonomous CPRA System — Agency Timeline Events
// ---------------------------------------------------------------------------

model CpraTimelineEvent {
  eventId         String    @id @default(uuid())
  agencyId        String
  eventType       String    // REQUEST_SENT | EMAIL_RECEIVED | ATTACHMENT_DETECTED | POLICY_UPLOADED | POLICY_INGESTED | FOLLOW_UP_SENT | STATUS_CHANGED
  title           String
  description     String?
  metadata        String?   // JSON: attachments, policy topics, subjects, etc.

  createdAt       DateTime  @default(now())

  @@index([agencyId])
  @@index([eventType])
  @@index([createdAt])
  @@map("cpra_timeline_events")
}

// ---------------------------------------------------------------------------
// Core Evidence System — Case Management
// ---------------------------------------------------------------------------

model CriminalCase {
  caseId          String   @id @default(uuid())
  tenantId        String
  ownerId         String
  title           String
  caseNumber      String
  jurisdiction    String
  caseType        String   // felony | misdemeanor | infraction | federal
  status          String   @default("active") // active | pending | closed | archived
  phase           String   @default("intake") // intake | preliminary | pretrial | trial | sentencing | appeal | closed
  court           String?
  judge           String?
  department      String?
  nextHearing     DateTime?
  nextHearingNote String?
  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        Evidence[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([caseType])
  @@index([createdAt])
  @@map("criminal_cases")
}

// ---------------------------------------------------------------------------
// Core Evidence System — Evidence Metadata
// ---------------------------------------------------------------------------

model Evidence {
  evidenceId      String   @id @default(uuid())
  caseId          String
  case            CriminalCase @relation(fields: [caseId], references: [caseId])
  tenantId        String
  fileName        String
  mimeType        String?
  size            BigInt   @default(0)
  duration        Int?     // seconds, for video
  pageCount       Int?     // for documents
  evidenceType    String   // transcript | police_report | bodycam | dashcam | witness_video | photo | dispatch_log | forensic_report | autopsy_report | other_document
  s3Key           String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  // Processing status
  processingStatus String  @default("pending") // pending | ingesting | normalized | analyzed | failed
  processingError  String?

  // Document normalization
  multiplexDetected Boolean @default(false)
  multiplexCount    Int?
  normalizedPageCount Int?

  // ACU compute preparation (Part 15)
  acuCost          Float?
  acuConsumed      Float    @default(0)
  analysisStatus   String   @default("pending") // pending | queued | processing | completed | failed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceType])
  @@index([processingStatus])
  @@index([analysisStatus])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Narrative Deconstruction Engine — Claims extracted from police narratives
// ---------------------------------------------------------------------------

model NarrativeClaim {
  claimId            String   @id @default(uuid())
  caseId             String
  tenantId           String
  evidenceId         String
  claimText          String
  subject            String
  action             String
  object             String?
  target             String?
  timestampReference String?
  confidence         Float    @default(0.5)
  sentenceIndex      Int      @default(0)
  metadata           Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceId])
  @@index([caseId, evidenceId])
  @@index([confidence])
  @@map("narrative_claims")
}

// ---------------------------------------------------------------------------
// Narrative Deconstruction Engine — Normalized claim events
// ---------------------------------------------------------------------------

model NormalizedClaimEvent {
  eventId       String   @id @default(uuid())
  claimId       String
  caseId        String
  tenantId      String
  eventType     String
  actor         String
  actionNorm    String
  object        String?
  target        String?
  timestamp     DateTime?
  confidence    Float    @default(0.5)
  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([claimId])
  @@index([caseId])
  @@index([tenantId])
  @@index([eventType])
  @@map("normalized_claim_events")
}

// ---------------------------------------------------------------------------
// Narrative Deconstruction Engine — Claim validation results
// ---------------------------------------------------------------------------

model ClaimValidation {
  validationId            String   @id @default(uuid())
  claimId                 String
  caseId                  String
  tenantId                String
  status                  String   @default("pending") // supported | contradicted | unverified | pending
  supportingEvidenceIds   Json     @default("[]")
  contradictingEvidenceIds Json    @default("[]")
  confidence              Float    @default(0.5)
  reasoning               String?
  metadata                Json?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([claimId])
  @@index([caseId])
  @@index([tenantId])
  @@index([status])
  @@map("claim_validations")
}

// ---------------------------------------------------------------------------
// Narrative Deconstruction Engine — Impeachment candidates
// ---------------------------------------------------------------------------

model ImpeachmentCandidate {
  impeachmentId          String   @id @default(uuid())
  claimId                String
  caseId                 String
  tenantId               String
  severity               String   @default("medium") // high | medium | low
  contradictionType      String
  claimText              String
  contradictingEvidence  String
  suggestedQuestion      String?
  confidence             Float    @default(0.5)
  metadata               Json?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([claimId])
  @@index([caseId])
  @@index([tenantId])
  @@index([severity])
  @@map("impeachment_candidates")
}

// ---------------------------------------------------------------------------
// Stripe Webhook Event — idempotency protection for Stripe webhook retries
// Stores processed event IDs to prevent duplicate handling of the same event.
// ---------------------------------------------------------------------------

model StripeWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique    // Stripe event ID (evt_xxx)
  eventType   String              // e.g. checkout.session.completed
  processedAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}
