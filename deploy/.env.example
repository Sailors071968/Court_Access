# Copy to deploy/.env and fill in. Do not commit the filled copy.

POSTGRES_USER=courtaccess
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=courtaccess

# Signs access and refresh tokens. Changing it signs everyone out.
JWT_SECRET=                   # generate: openssl rand -base64 48

# The administrator created by bootstrap-admin.mjs.
ADMIN_EMAIL=
ADMIN_PASSWORD=               # generate: openssl rand -base64 24
ADMIN_NAME=CourtAccess Administrator
