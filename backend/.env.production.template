# ============================================================================
# CourtAccess — Production Environment Variables Template
# Phase 7: Environment Variable Audit
# Copy to .env and fill in all values before deployment.
# NEVER commit the actual .env file with real secrets.
# ============================================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/courtaccess?schema=public"

# --- Authentication ---
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING"
COOKIE_SECRET="REPLACE_WITH_SECURE_RANDOM_32_CHAR_STRING"

# --- Server ---
NODE_ENV="production"
PORT="3001"
HOST="0.0.0.0"
FRONTEND_URL="https://courtaccess.net"

# --- OpenAI (AI classification, analysis) ---
OPENAI_API_KEY="sk-REPLACE_WITH_PRODUCTION_KEY"

# --- AWS SES (CPRA email pipeline) ---
AWS_SES_REGION="us-east-1"
AWS_SES_FROM_EMAIL="cpra@courtaccess.net"
AWS_ACCESS_KEY_ID="REPLACE_WITH_AWS_KEY"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_AWS_SECRET"

# --- Cloudflare R2 (attachment storage) ---
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_KEY"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET"
R2_BUCKET_NAME="courtaccess-cpra-attachments"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# --- Stripe (billing) ---
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_LIVE_KEY"
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_LIVE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_WEBHOOK_SECRET"

# Stripe Price IDs (create in Stripe Dashboard, set lookup_key on subscription prices)
STRIPE_PRICE_STARTER="price_REPLACE_STARTER"
STRIPE_PRICE_PROFESSIONAL="price_REPLACE_PROFESSIONAL"
STRIPE_PRICE_ADVANCED="price_REPLACE_ADVANCED"
STRIPE_PRICE_LITIGATION="price_REPLACE_LITIGATION"
STRIPE_PRICE_ENTERPRISE="price_REPLACE_ENTERPRISE"
STRIPE_PRICE_CREDIT_50="price_REPLACE_CREDIT_50"
STRIPE_PRICE_CREDIT_150="price_REPLACE_CREDIT_150"
STRIPE_PRICE_CREDIT_500="price_REPLACE_CREDIT_500"
STRIPE_PRICE_CREDIT_1500="price_REPLACE_CREDIT_1500"

# --- Redis (optional, for session store / rate limiting) ---
# REDIS_URL="redis://HOST:6379"

# --- CPRA Pipeline ---
CPRA_SIMULATION_MODE="false"
CPRA_MAX_EMAILS_PER_DAY="50"
CPRA_MAX_EMAILS_PER_MINUTE="5"
CPRA_INBOX_POLL_INTERVAL_MS="60000"

# --- Logging ---
LOG_LEVEL="info"
