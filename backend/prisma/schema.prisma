  phone                 String?
  phoneAlt              String?

  alternateContacts     Json?     // [{ name, relationship, phone, email }]
  emergencyContacts     Json?     // [{ name, relationship, phone }]
  addressHistory        Json?     // [{ line1, line2, city, state, zip, country, from, to }]

