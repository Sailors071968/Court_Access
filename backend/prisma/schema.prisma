// ---------------------------------------------------------------------------
// Core Evidence System — Case Management
// ---------------------------------------------------------------------------

model CriminalCase {
  caseId          String   @id @default(uuid())
  tenantId        String
  ownerId         String
  title           String
  caseNumber      String
  jurisdiction    String
  caseType        String   // felony | misdemeanor | infraction | federal
  status          String   @default("active") // active | pending | closed | archived
  phase           String   @default("intake") // intake | preliminary | pretrial | trial | sentencing | appeal | closed
  court           String?
  judge           String?
  department      String?
  nextHearing     DateTime?
  nextHearingNote String?
  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        Evidence[]
  charges         Charge[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([caseType])
  @@index([createdAt])
  @@map("criminal_cases")
}

// ---------------------------------------------------------------------------
// Core Evidence System — Evidence Metadata
// ---------------------------------------------------------------------------

model Evidence {
  evidenceId      String   @id @default(uuid())
  caseId          String
  case            CriminalCase @relation(fields: [caseId], references: [caseId])
  tenantId        String
  fileName        String
  mimeType        String?
  size            BigInt   @default(0)
  duration        Int?     // seconds, for video
  pageCount       Int?     // for documents
  evidenceType    String   // transcript | police_report | bodycam | dashcam | witness_video | photo | dispatch_log | forensic_report | autopsy_report | other_document
  s3Key           String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  // Processing status
  processingStatus String  @default("pending") // pending | ingesting | normalized | analyzed | failed
  processingError  String?

  // Document normalization
  multiplexDetected Boolean @default(false)
  multiplexCount    Int?
  normalizedPageCount Int?

  // ACU compute preparation (Part 15)
  acuCost          Float?
  acuConsumed      Float    @default(0)
  analysisStatus   String   @default("pending") // pending | queued | processing | completed | failed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceType])
  @@index([processingStatus])
  @@index([analysisStatus])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// PR 3 — Evidence Chunks — Breaks large evidence into manageable pieces
// ---------------------------------------------------------------------------

model EvidenceChunk {
  id             String   @id @default(uuid())
  evidenceId     String
  tenantId       String
  chunkIndex     Int      // Zero-based ordering within the evidence
  text           String   // The chunk text content
  startOffset    Int      // Character offset in the original document
  endOffset      Int      // Character end offset in the original document
  checksum       String   // SHA-256 truncated to 16 hex chars
  charCount      Int      // Character count of this chunk

  createdAt      DateTime @default(now())

  @@unique([evidenceId, chunkIndex])
  @@index([evidenceId])
  @@index([tenantId])
  @@index([checksum])
  @@map("evidence_chunks")
}

// ---------------------------------------------------------------------------
// PR 4 — Verified Fact Registry — Immutable, SHA-256 hashed, tenant-isolated
// ---------------------------------------------------------------------------

model VerifiedFact {
  factId            String    @id @default(uuid())
  caseId            String
  tenantId          String
  factType          String    // event | claim | observation | measurement | identity | location | timestamp_anchor | contradiction
  content           String    // The fact statement
  contentHash       String    // SHA-256 hash of tenantId:caseId:content
  sourceEvidenceId  String    // Which evidence produced this fact
  sourceType        String    // timeline_event | narrative_claim | evidence_event | manual
  confidence        Float     @default(0.5)
  lockedAt          DateTime? // Once set, fact is immutable
  metadata          String?   // JSON: additional structured data

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([caseId, tenantId, contentHash])
  @@index([caseId])
  @@index([tenantId])
  @@index([factType])
  @@index([contentHash])
  @@index([sourceEvidenceId])
  @@index([lockedAt])
  @@index([confidence])
  @@map("verified_facts")
}

