// Court Access — Prisma Schema
// Database models for persistent storage.
// Phases 36-45: Full system integration models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 36/39/43 — Users & Authentication
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String   @default("")
  role              String   @default("attorney") // admin, attorney, investigator, client, staff
  status            String   @default("active")   // active, inactive, suspended, onboarding
  plan              String   @default("free")      // free, professional, team
  stripeCustomerId  String?  @unique
  subscriptionId    String?
  subscriptionStatus String  @default("none")      // none, active, past_due, cancelled
  betaInviteId      String?
  onboardingComplete Boolean @default(false)
  storageUsedBytes  BigInt   @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cases             Case[]
  evidenceRecords   EvidenceRecord[]
  auditLogs         UserAuditLog[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 36/43 — Beta Invites
// ---------------------------------------------------------------------------

model BetaInvite {
  id          String   @id @default(uuid())
  email       String
  role        String   @default("attorney")
  inviteCode  String   @unique
  status      String   @default("pending") // pending, accepted, expired, revoked
  sentAt      DateTime @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([inviteCode])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 36 — Cases
// ---------------------------------------------------------------------------

model Case {
  id          String   @id @default(uuid())
  userId      String
  caseNumber  String   @default("")
  caseName    String
  description String   @default("")
  status      String   @default("active") // active, closed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceRecords EvidenceRecord[]

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 36/37 — Evidence Records (Prisma-backed, replaces in-memory Map)
// ---------------------------------------------------------------------------

model EvidenceRecord {
  id            String   @id @default(uuid())
  userId        String
  caseId        String
  filename      String
  contentType   String
  evidenceType  String   // document, image, audio, video
  fileSize      BigInt   @default(0)
  sha256        String   @default("")
  storageKey    String?
  description   String   @default("")
  status        String   @default("pending") // pending, pending_upload, processing, complete, error, rejected
  processingResult Json?
  scanResult    Json?
  jobId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
  @@index([status])
  @@index([caseId, status])
}

// ---------------------------------------------------------------------------
// Phase 39 — Subscription Events (audit trail for Stripe lifecycle)
// ---------------------------------------------------------------------------

model SubscriptionEvent {
  id                String   @id @default(uuid())
  stripeCustomerId  String
  stripeEventId     String   @unique
  eventType         String   // checkout.session.completed, invoice.payment_succeeded, etc.
  plan              String   @default("free")
  amount            Int      @default(0)
  currency          String   @default("usd")
  status            String   @default("")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())

  @@index([stripeCustomerId])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Phase 42 — System Error Log (persistent error tracking)
// ---------------------------------------------------------------------------

model SystemErrorLog {
  id          String   @id @default(uuid())
  service     String   // api, evidence-processor, audio-processor, video-processor, upload, stripe
  level       String   @default("error") // info, warn, error
  message     String
  stackTrace  String?
  metadata    Json     @default("{}")
  resolved    Boolean  @default(false)
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([service])
  @@index([level])
  @@index([resolved])
  @@index([lastSeen])
}

// ---------------------------------------------------------------------------
// Phase 40/42 — User Audit Log (security + access tracking)
// ---------------------------------------------------------------------------

model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // login, logout, evidence_access, case_create, evidence_upload, admin_action
  resource  String   @default("") // e.g. caseId, evidenceId
  ipAddress String   @default("")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Court Hearings
// ---------------------------------------------------------------------------

model Hearing {
  id                String   @id @default(uuid())
  caseId            String
  courthouseName    String
  courthouseAddress String
  hearingName       String
  hearingDatetime   DateTime
  department        String   @default("")
  caseName          String?
  clientPhone       String?

  reminder1Enabled    Boolean @default(true)
  reminder2Enabled    Boolean @default(true)
  reminder3Enabled    Boolean @default(true)

  reminder1DaysBefore Int @default(7)
  reminder2DaysBefore Int @default(3)
  reminder3DaysBefore Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminderLogs HearingReminderLog[]

  @@index([caseId])
}

model HearingReminderLog {
  id           String   @id @default(uuid())
  hearingId    String
  reminderType Int
  sentAt       DateTime @default(now())

  hearing Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)

  @@unique([hearingId, reminderType])
  @@index([hearingId])
}

// ---------------------------------------------------------------------------
// Reminder Failures — tracks failed SMS delivery attempts
// ---------------------------------------------------------------------------

model ReminderFailure {
  id           String   @id @default(uuid())
  hearingId    String
  reminderType Int
  phone        String
  errorMessage String
  attempt      Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([hearingId])
  @@index([phone])
}

// ---------------------------------------------------------------------------
// SMS Rate Log — tracks SMS sends per phone for rate protection
// ---------------------------------------------------------------------------

model SmsRateLog {
  id        String   @id @default(uuid())
  phone     String
  sentAt    DateTime @default(now())

  @@index([phone, sentAt])
}

// ---------------------------------------------------------------------------
// Phase A — Evidence Timeline Events
// ---------------------------------------------------------------------------

model TimelineEvent {
  id                String   @id @default(uuid())
  caseId            String
  timestamp         DateTime
  sourceEvidenceId  String?
  sourceType        String   // audio_transcript, video_transcript, document_date, image_exif, manual
  eventType         String   @default("other")
  eventDescription  String
  confidenceScore   Float    @default(1.0)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@index([caseId, timestamp])
}

// ---------------------------------------------------------------------------
// Phase B — Entity Linking
// ---------------------------------------------------------------------------

model Entity {
  id                      String   @id @default(uuid())
  caseId                  String
  entityType              String   // person, organization, location, phone_number, vehicle, date, email_address
  entityValue             String
  firstDetectedEvidenceId String?
  createdAt               DateTime @default(now())

  links EvidenceEntityLink[]

  @@unique([caseId, entityType, entityValue])
  @@index([caseId])
  @@index([caseId, entityType])
}

model EvidenceEntityLink {
  id                  String   @id @default(uuid())
  entityId            String
  evidenceId          String
  detectionConfidence Float    @default(1.0)
  contextSnippet      String   @default("")
  createdAt           DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, evidenceId])
  @@index([entityId])
  @@index([evidenceId])
}

// ---------------------------------------------------------------------------
// Phase C — AI Case Narrative
// ---------------------------------------------------------------------------

model CaseNarrative {
  id                 String   @id @default(uuid())
  caseId             String
  generatedTimestamp DateTime @default(now())
  summaryText        String
  keyEvents          Json     @default("[]")
  conflictsDetected  Json     @default("[]")
  participants       Json     @default("[]")
  modelVersion       String   @default("gpt-4")
  createdAt          DateTime @default(now())

  @@index([caseId])
  @@index([caseId, generatedTimestamp])
}

// ---------------------------------------------------------------------------
// Phase D — Evidence Integrity Certificates
// ---------------------------------------------------------------------------

model EvidenceIntegrityReport {
  id                 String   @id @default(uuid())
  evidenceId         String
  caseId             String
  fileName           String   @default("")
  sha256Hash         String
  sha3Hash           String
  uploadTimestamp    DateTime
  verificationStatus String   @default("verified") // verified, failed, pending
  chainOfCustody     Json     @default("[]")
  createdAt          DateTime @default(now())

  @@unique([evidenceId])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Phase E — Cold Archive System
// ---------------------------------------------------------------------------

model ArchiveRecord {
  id               String   @id @default(uuid())
  caseId           String
  archiveHash      String
  archiveLocation  String
  archiveTimestamp DateTime @default(now())
  archiveManifest  Json     @default("{}")
  status           String   @default("archived") // archived, restoring, restored, failed
  fileCount        Int      @default(0)
  totalSizeBytes   BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([caseId])
  @@index([status])
}

model ArchiveAuditLog {
  id        String   @id @default(uuid())
  caseId    String
  action    String   // archive_initiated, archive_completed, restore_initiated, restore_completed, hash_verified, hash_failed
  actor     String   @default("system")
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 52 — Media Transcripts
// ---------------------------------------------------------------------------

model MediaTranscript {
  id               String   @id @default(uuid())
  evidenceId       String
  caseId           String
  speakerLabel     String   @default("")
  startTime        Float    @default(0)   // seconds
  endTime          Float    @default(0)   // seconds
  transcriptText   String
  confidenceScore  Float    @default(0.0)
  language         String   @default("en")
  modelVersion     String   @default("whisper-1")
  fullTranscript   Boolean  @default(false) // true = full file transcript, false = segment
  status           String   @default("pending") // pending, processing, complete, error
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([evidenceId])
  @@index([caseId])
  @@index([caseId, evidenceId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 53 — Evidence Correlations
// ---------------------------------------------------------------------------

model EvidenceCorrelation {
  id                  String   @id @default(uuid())
  caseId              String
  sourceEvidenceId    String
  relatedEvidenceId   String
  correlationType     String   // timeline_mismatch, statement_contradiction, entity_reference_match, event_confirmation
  confidenceScore     Float    @default(0.0)
  description         String
  sourceSnippet       String   @default("")
  relatedSnippet      String   @default("")
  metadata            Json     @default("{}")
  status              String   @default("active") // active, dismissed, confirmed
  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([sourceEvidenceId])
  @@index([relatedEvidenceId])
  @@index([caseId, correlationType])
}

// ---------------------------------------------------------------------------
// Phase 54 — Policy Documents
// ---------------------------------------------------------------------------

model PolicyDocument {
  id              String   @id @default(uuid())
  caseId          String
  title           String
  documentType    String   // police_policy, use_of_force, arrest_procedure, bodycam_rules, evidence_handling
  content         String   @default("")
  sections        Json     @default("[]")  // parsed sections: [{sectionId, title, content}]
  uploadedBy      String?
  status          String   @default("active") // active, archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  findings        PolicyComplianceFinding[]

  @@index([caseId])
  @@index([caseId, documentType])
}

// ---------------------------------------------------------------------------
// Phase 54 — Policy Compliance Findings
// ---------------------------------------------------------------------------

model PolicyComplianceFinding {
  id                 String   @id @default(uuid())
  caseId             String
  evidenceId         String
  policyDocumentId   String
  policySection      String   @default("")
  description        String
  confidenceScore    Float    @default(0.0)
  severity           String   @default("medium") // low, medium, high, critical
  status             String   @default("active") // active, dismissed, confirmed, resolved
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())

  policyDocument     PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([evidenceId])
  @@index([policyDocumentId])
  @@index([caseId, severity])
}

// ---------------------------------------------------------------------------
// Phase 63 — Verified Email Registry (SES Sandbox)
// ---------------------------------------------------------------------------

model VerifiedEmail {
  id                  String   @id @default(uuid())
  emailAddress        String   @unique
  verificationStatus  String   @default("pending") // pending, verified, failed
  verificationToken   String   @unique @default(uuid())
  verifiedAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([emailAddress])
  @@index([verificationStatus])
}

// ---------------------------------------------------------------------------
// Phase 65 — Email Job Queue
// ---------------------------------------------------------------------------

model EmailJob {
  id            String   @id @default(uuid())
  emailType     String   // transactional, notification, invite, processing_alert
  recipient     String
  payload       Json     @default("{}")
  status        String   @default("pending") // pending, queued, sent, failed, blocked
  attemptCount  Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([emailType])
  @@index([recipient])
}

// ---------------------------------------------------------------------------
// Phase 67 — Email Log
// ---------------------------------------------------------------------------

model EmailLog {
  id              String   @id @default(uuid())
  recipient       String
  emailType       String
  subject         String   @default("")
  deliveryStatus  String   @default("pending") // pending, sent, delivered, bounced, failed
  errorMessage    String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([recipient])
  @@index([emailType])
  @@index([deliveryStatus])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 70 — Law Enforcement Agency Intelligence Database
// ---------------------------------------------------------------------------

model LawEnforcementAgency {
  id                    String   @id @default(uuid())
  tenantId              String   // Phase 3 tenant isolation
  agencyName            String
  agencyType            String   // state_police, county_sheriff, city_police, regional_task_force, transit_police, university_police, other
  state                 String
  county                String   @default("")
  city                  String   @default("")
  address               String   @default("")
  phoneMain             String   @default("")
  phoneRecordsDivision  String   @default("")
  emailRecordsDivision  String   @default("")
  website               String   @default("")
  recordsRequestUrl     String   @default("")
  dataSource            String   @default("") // URL or source identifier
  verificationStatus    String   @default("pending") // pending, approved, rejected, needs_review
  lastVerifiedAt        DateTime?
  discoveredAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recordsRequests       PublicRecordsRequest[]

  @@unique([tenantId, agencyName, state])
  @@index([tenantId])
  @@index([state])
  @@index([agencyType])
  @@index([verificationStatus])
  @@index([tenantId, state])
}

// ---------------------------------------------------------------------------
// Phase 76 — Public Records Request Tracking
// ---------------------------------------------------------------------------

model PublicRecordsRequest {
  id                    String   @id @default(uuid())
  agencyId              String
  tenantId              String   // Phase 3 tenant isolation
  caseId                String?  // Optional link to case
  requestType           String   // public_records, body_camera, dispatch_logs, policy_manual, incident_report
  submissionDate        DateTime @default(now())
  deliveryMethod        String   @default("email") // email, mail, portal, fax
  status                String   @default("submitted") // submitted, acknowledged, fulfilled, partial_response, denied, no_response
  responseReceivedDate  DateTime?
  responseHash          String?  // SHA-256 of response document
  responseHashSha3      String?  // SHA3-256 of response document (Phase 87 dual-hash)
  requestDocumentHash   String?  // SHA-256 of outgoing request
  requestDocumentHashSha3 String? // SHA3-256 of outgoing request (Phase 87 dual-hash)
  requestContent        String   @default("") // The actual request text
  templateId            String?  // Reference to template used
  staffApproved         Boolean  @default(false)
  staffApprovedBy       String?
  staffApprovedAt       DateTime?
  notes                 String   @default("")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  agency                LawEnforcementAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agencyId])
  @@index([caseId])
  @@index([status])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Phase 80 — Records Request Templates
// ---------------------------------------------------------------------------

model RecordsRequestTemplate {
  id            String   @id @default(uuid())
  tenantId      String
  templateName  String   // public_records, body_camera, dispatch_logs, policy_manual, incident_report
  displayName   String
  content       String   // Template text with merge fields: {{agency_name}}, {{records_email}}, etc.
  mergeFields   Json     @default("[]") // Available merge fields
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, templateName])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Phase 82 — Evidence Reference Entities (extracted from agency responses)
// ---------------------------------------------------------------------------

model EvidenceReference {
  id                String   @id @default(uuid())
  caseId            String
  tenantId          String
  sourceDocumentId  String   // Evidence record ID or records request response
  referenceType     String   // incident_number, officer_name, date, case_number, badge_number
  referenceValue    String
  sourceContext     String   @default("") // Surrounding text snippet
  extractionMethod  String   @default("deterministic") // deterministic only, no probabilistic
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@index([tenantId])
  @@index([referenceType])
  @@index([caseId, referenceType])
  @@index([referenceValue])
}

// ---------------------------------------------------------------------------
// Phase 83 — Document Cross-Reference Results
// ---------------------------------------------------------------------------

model DocumentCrossReference {
  id                  String   @id @default(uuid())
  caseId              String
  tenantId            String
  sourceDocumentId    String
  relatedDocumentId   String
  referenceType       String   // reference_match, reference_conflict, missing_reference
  sourceReferenceId   String?  // Links to EvidenceReference
  relatedReferenceId  String?  // Links to EvidenceReference
  description         String
  sourceSnippet       String   @default("")
  relatedSnippet      String   @default("")
  status              String   @default("active") // active, dismissed, confirmed
  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([tenantId])
  @@index([referenceType])
  @@index([caseId, referenceType])
}
