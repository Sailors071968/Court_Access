// ---------------------------------------------------------------------------
// Core Evidence System — Evidence Metadata
// ---------------------------------------------------------------------------

model Evidence {
  evidenceId      String   @id @default(uuid())
  caseId          String
  case            CriminalCase @relation(fields: [caseId], references: [caseId])
  tenantId        String
  fileName        String
  mimeType        String?
  size            BigInt   @default(0)
  duration        Int?     // seconds, for video
  pageCount       Int?     // for documents
  evidenceType    String   // transcript | police_report | bodycam | dashcam | witness_video | photo | dispatch_log | forensic_report | autopsy_report | other_document
  s3Key           String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  // Processing status
  processingStatus String  @default("pending") // pending | ingesting | normalized | analyzed | failed
  processingError  String?

  // Document normalization
  multiplexDetected Boolean @default(false)
  multiplexCount    Int?
  normalizedPageCount Int?

  // Page boundaries within the extracted text, as
  // [{ page, startOffset, endOffset }]. Lets any character offset in a chunk
  // or an extracted event be resolved back to a page and a line on that page,
  // which is what a citation in a brief has to name.
  pageMap          Json?

  // ACU compute preparation (Part 15)
  acuCost          Float?
  acuConsumed      Float    @default(0)
  analysisStatus   String   @default("pending") // pending | queued | processing | completed | failed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceType])
  @@index([processingStatus])
  @@index([analysisStatus])
  @@map("evidence")
}

