// Court Access — Backend Prisma Schema
// Manages corpus ingestion state, audit logs, and legal document storage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion State — checkpoint/resume system
// ---------------------------------------------------------------------------

model CorpusIngestionState {
  id                   String   @id @default(uuid())
  corpusName           String
  fileName             String
  lastProcessedOffset  Int      @default(0)
  recordsProcessed     Int      @default(0)
  totalRecords         Int?
  status               String   @default("pending") // pending | in_progress | completed | failed | paused
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([corpusName, fileName])
  @@index([corpusName])
  @@index([status])
  @@map("corpus_ingestion_state")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion Log — batch-level audit trail
// ---------------------------------------------------------------------------

model CorpusIngestionLog {
  id              String   @id @default(uuid())
  corpusName      String
  batchNumber     Int
  recordsInserted Int
  durationMs      Int
  status          String   // success | failed | skipped
  errorMessage    String?
  timestamp       DateTime @default(now())

  @@index([corpusName])
  @@index([timestamp])
  @@map("corpus_ingestion_log")
}

// ---------------------------------------------------------------------------
// Legal Document — normalized corpus storage
// ---------------------------------------------------------------------------

model LegalDocument {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  content         String
  jurisdiction    String
  documentType    String   // policy | statute | case_law | transcript | evidence | investigative_report
  source          String
  version         String   @default("1.0")
  corpusName      String?
  sourceFile      String?
  contentHash     String   // SHA-256 of content for dedup
  corpusVersion   String?  // Version of the corpus this document belongs to
  documentVersion String   @default("1.0") // Version of this specific document
  supersededBy    String?  // ID of the document that supersedes this one
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contentHash, tenantId])
  @@index([tenantId])
  @@index([documentType])
  @@index([corpusName])
  @@index([jurisdiction])
  @@index([contentHash])
  @@index([supersededBy])
  @@map("legal_documents")
}

// ---------------------------------------------------------------------------
// Corpus Registry — tracks all registered corpora and their versions
// ---------------------------------------------------------------------------

model CorpusRegistry {
  id               String   @id @default(uuid())
  corpusName       String
  jurisdiction     String
  sourceAuthority  String   // e.g. "California Legislature", "US Congress"
  version          String   @default("1.0")
  releaseDate      DateTime?
  ingestionStatus  String   @default("pending") // pending | in_progress | completed | failed
  totalDocuments   Int      @default(0)
  totalBytes       BigInt   @default(0)
  checksum         String?  // SHA-256 of the entire corpus file
  metadata         String?  // JSON string for extensible metadata
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([corpusName, version])
  @@index([corpusName])
  @@index([jurisdiction])
  @@index([ingestionStatus])
  @@map("corpus_registry")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion Lock — prevents concurrent ingestion of the same corpus
// ---------------------------------------------------------------------------

model CorpusIngestionLock {
  id          String   @id @default(uuid())
  corpusName  String   @unique
  workerId    String
  lockedAt    DateTime @default(now())
  expiresAt   DateTime // Auto-expire to prevent deadlocks
  metadata    String?  // JSON string for worker info

  @@index([corpusName])
  @@index([expiresAt])
  @@map("corpus_ingestion_lock")
}

// ---------------------------------------------------------------------------
// Doctrine Rule — structured training doctrine from POST manuals
// ---------------------------------------------------------------------------

model DoctrineRule {
  id                String   @id @default(uuid())
  doctrineId        String   @unique // e.g. POST_LD15_RS_001
  sourceType        String   // POST | DOJ | AGENCY
  sourceName        String   // e.g. "POST LD-15"
  sourceVersion     String   @default("1.0") // e.g. "5.0"
  domain            String   // e.g. "Laws of Arrest"
  chapter           String   // e.g. "Detentions"
  topic             String   // e.g. "Reasonable Suspicion"
  ruleText          String   // The actual doctrine rule
  explanation       String?  // Detailed explanation
  legalImplication  String?  // What happens if violated
  category          String   // constitutional | encounter | detention | search | arrest | miranda | interrogation
  keywords          String[] // Searchable keywords
  contentHash       String   // SHA-256 for dedup
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contentHash])
  @@index([sourceType])
  @@index([sourceName])
  @@index([domain])
  @@index([chapter])
  @@index([topic])
  @@index([category])
  @@map("doctrine_rules")
}

// ---------------------------------------------------------------------------
// Doctrine Embedding — vector storage for doctrine rules
// ---------------------------------------------------------------------------

model DoctrineEmbedding {
  id            String   @id @default(uuid())
  doctrineId    String   @unique // References DoctrineRule.doctrineId
  model         String   @default("text-embedding-3-large")
  dimensions    Int      @default(1536)
  embeddingJson String   // JSON-encoded float array (pgvector requires extension)
  createdAt     DateTime @default(now())

  @@index([doctrineId])
  @@map("doctrine_embeddings")
}

// ---------------------------------------------------------------------------
// Doctrine Match Log — audit trail of doctrine matches against evidence
// ---------------------------------------------------------------------------

model DoctrineMatchLog {
  id              String   @id @default(uuid())
  caseId          String
  evidenceText    String   // The input text that was matched
  doctrineId      String   // Matched doctrine rule
  similarityScore Float    // Cosine similarity score
  flagType        String   // violation | concern | compliant
  flagDescription String   // Human-readable description of the flag
  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([doctrineId])
  @@index([flagType])
  @@index([similarityScore])
  @@map("doctrine_match_log")
}
