  visibilityResults String  // JSON: VisibilityResult[]
  obstructionMap   String   // JSON: ObstructionMap
  summary          String   // JSON: LineOfSightSummary

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@index([sceneId])
  @@map("line_of_sight_analyses")
}

