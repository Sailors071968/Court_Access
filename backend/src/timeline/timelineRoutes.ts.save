// ============================================================================
// CourtAccess — Timeline Reconstruction Engine Routes (FIXED + HARDENED)
// ============================================================================

import { buildExplainableArguments } from "../services/explainableArgumentEngine";
import type { FastifyInstance, FastifyReply } from 'fastify';
import { authMiddleware } from '../middleware/authMiddleware';
import type { AuthenticatedRequest } from '../security/authMiddleware.js';

import {
  getTimeline,
  getTimelineEvents,
  getTimelineConflicts,
} from './timelineReconstructionService.js';

import { enqueueTimelineProcessing } from '../workers/pipelineJobService.js';
import { getQueueHealth } from '../lib/queues.js';

import { runLegalAnalysis } from '../services/legalAnalysisEngine';

// ============================================================================
// SAFE USER + TENANT RESOLVER (CRITICAL FIX)
// ============================================================================
function resolveContext(request: AuthenticatedRequest) {
  const user = request.user || {};

  const tenantId =
    (user as any)?.tenantId ||
    'dev-tenant'; // 🔥 FORCE fallback so DB matches

  const userId =
    (user as any)?.userId ||
    'dev-user';

  console.log('🧠 AUTH CONTEXT:', { userId, tenantId });

  return { userId, tenantId };
}

// ============================================================================
// REGISTER ROUTES
// ============================================================================

export async function registerTimelineRoutes(app: FastifyInstance): Promise<void> {

  // --------------------------------------------------------------------------
  // GET /api/timeline/:caseId/events (WITH CALCRIM ANALYSIS)
  // --------------------------------------------------------------------------
  app.get(
    '/api/timeline/:caseId/events',
    { preHandler: authMiddleware },
    async (request: AuthenticatedRequest, reply: FastifyReply) => {

      const { userId, tenantId } = resolveContext(request);
      const { caseId } = request.params as { caseId: string };

      const query = request.query as {
        sourceType?: string;
        minConfidence?: string;
        conflictsOnly?: string;
        limit?: string;
        offset?: string;
      };

      try {
        const result = await getTimelineEvents(caseId, tenantId, {
          sourceType: query.sourceType,
          minConfidence: query.minConfidence
            ? parseFloat(query.minConfidence)
            : undefined,
          conflictsOnly: query.conflictsOnly === 'true',
          limit: query.limit ? parseInt(query.limit, 10) : 50,
          offset: query.offset ? parseInt(query.offset, 10) : 0,
        });

        // Normalize events
        const eventList = Array.isArray(result)
          ? result
          : Array.isArray((result as any)?.events)
            ? (result as any).events
            : [];

        // 🔥 CALCRIM ENGINE
        const analysis = runLegalAnalysis({
          events: eventList,
          contradictions: [],
          crimeType: 'burglary', // 🔥 you can make this dynamic later
        });
        const argumentsOutput = buildExplainableArguments(eventList);

        console.log(`📊 Timeline + Analysis for case ${caseId} (user ${userId})`);

        return {
          caseId,
          total: eventList.length,
          limit: query.limit ? parseInt(query.limit, 10) : 50,
          offset: query.offset ? parseInt(query.offset, 10) : 0,
          events: eventList,
          analysis,
        };

      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);

        console.error("❌ Timeline Events Error:", msg);

        return reply.code(500).send({
          error: 'Failed to fetch timeline events',
          message: msg,
        });
      }
    }
  );

  // --------------------------------------------------------------------------
  // GET /api/timeline/:caseId/conflicts
  // --------------------------------------------------------------------------
  app.get(
    '/api/timeline/:caseId/conflicts',
    { preHandler: authMiddleware },
    async (request: AuthenticatedRequest, reply: FastifyReply) => {

      const { tenantId } = resolveContext(request);
      const { caseId } = request.params as { caseId: string };

      try {
        const conflicts = await getTimelineConflicts(caseId, tenantId);
        return conflicts;

      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        return reply.code(500).send({
          error: 'Failed to fetch timeline conflicts',
          message: msg,
        });
      }
    }
  );

  // --------------------------------------------------------------------------
  // POST /api/timeline/rebuild/:caseId
  // --------------------------------------------------------------------------
  app.post(
    '/api/timeline/rebuild/:caseId',
    { preHandler: authMiddleware },
    async (request: AuthenticatedRequest, reply: FastifyReply) => {

      const { userId, tenantId } = resolveContext(request);
      const { caseId } = request.params as { caseId: string };

      try {
        const result = await enqueueTimelineProcessing({
          userId,
          tenantId,
          caseId,
        });

        return {
          caseId,
          status: result.status,
          jobId: result.jobId,
          processingJobId: result.processingJobId,
          message: 'Timeline reconstruction queued',
        };

      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        return reply.code(500).send({
          error: 'Failed to enqueue timeline rebuild',
          message: msg,
        });
      }
    }
  );

  // --------------------------------------------------------------------------
  // POST /api/timeline/process
  // --------------------------------------------------------------------------
  app.post(
    '/api/timeline/process',
    { preHandler: authMiddleware },
    async (request: AuthenticatedRequest, reply: FastifyReply) => {

      const { userId, tenantId } = resolveContext(request);
      const body = request.body as { caseId?: string } | undefined;

      if (!body?.caseId) {
        return reply.code(400).send({
          error: 'Missing required field: caseId',
        });
      }

      try {
        const result = await enqueueTimelineProcessing({
          userId,
          tenantId,
          caseId: body.caseId,
        });

        return {
          caseId: body.caseId,
          status: result.status,
          jobId: result.jobId,
          processingJobId: result.processingJobId,
          message: 'Timeline processing queued',
        };

      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        return reply.code(500).send({
          error: 'Failed to enqueue timeline processing',
          message: msg,
        });
      }
    }
  );

  // --------------------------------------------------------------------------
  // GET /api/timeline/health
  // --------------------------------------------------------------------------
  app.get('/api/timeline/health', async () => {
    try {
      const queueHealth = await getQueueHealth();

      return {
        status: 'ok',
        engine: 'timeline-reconstruction',
        queue: queueHealth,
      };

    } catch {
      return {
        status: 'degraded',
        engine: 'timeline-reconstruction',
        queue: null,
      };
    }
  });

  console.log('[Server] Timeline routes registered (FIXED + CALCRIM ENABLED)');
}
