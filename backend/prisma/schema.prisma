model Client {
  clientId              String    @id @default(uuid())
  tenantId              String
  ownerId               String

  firstName             String
  lastName              String
  middleName            String?
  dateOfBirth           DateTime?
  status                String    @default("prospect") // prospect | intake | active | inactive | closed

  email                 String?
  phone                 String?
  phoneAlt              String?

  alternateContacts     Json?     // [{ name, relationship, phone, email }]
  emergencyContacts     Json?     // [{ name, relationship, phone }]
  addressHistory        Json?     // [{ line1, line2, city, state, zip, country, from, to }]

  communicationPreference String  @default("email") // email | phone | sms | mail
  language              String    @default("en")
  notes                 String?

  intakeDate            DateTime?
  retentionStatus       String    @default("pending") // pending | retained | declined
  retainedAt            DateTime?

  portalUserId          String?   // Linked defendant User.id

  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cases                 CriminalCase[]
  portalUsers           User[]
  teamAssignment        ClientTeamAssignment?

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([lastName, firstName])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Core Evidence System — Case Management
// ---------------------------------------------------------------------------

model CriminalCase {
  caseId          String   @id @default(uuid())
  tenantId        String
  ownerId         String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [clientId])
  officeId        String?
  title           String
  caseNumber      String
  jurisdiction    String
  caseType        String   // felony | misdemeanor | infraction | federal
  status          String   @default("active") // active | pending | closed | archived
  phase           String   @default("intake") // intake | preliminary | pretrial | trial | sentencing | appeal | closed
  court           String?
  judge           String?
  department      String?
  nextHearing     DateTime?
  nextHearingNote String?
  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        Evidence[]
  hearings        CaseHearing[]
  messages        CaseMessage[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId])
  @@index([ownerId])
  @@index([clientId])
  @@index([officeId])
  @@index([status])
  @@index([caseType])
  @@index([createdAt])
  @@map("criminal_cases")
}

