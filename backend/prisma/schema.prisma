// ---------------------------------------------------------------------------
// Multi-Tenant Platform — Organization (Domain B)
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id // matches User.tenantId for org members
  name        String
  orgType     String   @default("law_firm") // law_firm | solo | public_defender | investigator
  settings    Json?    // { timezone, defaultJurisdiction, notificationDefaults }
  logoUrl     String?
  primaryColor String? @default("#1e293b")
  secondaryColor String?
  tagline     String?
  website     String?
  billingEmail String?
  stripeCustomerId String?
  onboardingStep String @default("created") // created | profile | offices | team | complete
  onboardingCompletedAt DateTime?
  themeSettings Json?  // { fontFamily, accentColor, sidebarStyle }

  offices       OrganizationOffice[]
  departments   OrganizationDepartment[]
  practiceGroups PracticeGroup[]
  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  personnelProfiles PersonnelProfile[]
  knowledgeAssets KnowledgeAsset[]
  internalMessages OrgInternalMessage[]
  orgTasks      OrgTask[]
  conflictRecords ConflictRecord[]
  permissionGrants PermissionGrant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizations")
}

model OrganizationOffice {
  officeId       String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?  @default("CA")
  zip            String?
  phone          String?
  isPrimary      Boolean  @default(false)
  isBranch       Boolean  @default(false)

  departments    OrganizationDepartment[]
  practiceGroups PracticeGroup[]
  members        OrganizationMember[]
  users          User[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_offices")
}

model PracticeGroup {
  practiceGroupId String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  officeId        String?
  office          OrganizationOffice? @relation(fields: [officeId], references: [officeId])
  name            String
  description     String?
  practiceArea    String?  // criminal_defense | appellate | juvenile | federal

  members         OrganizationMember[]
  invitations     OrganizationInvitation[]
  users           User[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([officeId])
  @@map("practice_groups")
}

model OrganizationMember {
  memberId       String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String   // admin | attorney | investigator | staff
  caseRole       String?  // Program 4A — role within a specific case context
  personnelType  String?  // attorney | investigator | paralegal | legal_assistant | office_admin | receptionist | expert_witness | contract_investigator
  officeId       String?
  office         OrganizationOffice? @relation(fields: [officeId], references: [officeId])
  departmentId   String?
  department     OrganizationDepartment? @relation(fields: [departmentId], references: [departmentId])
  practiceGroupId String?
  practiceGroup  PracticeGroup? @relation(fields: [practiceGroupId], references: [practiceGroupId])
  status         String   @default("active") // active | suspended | removed
  invitedById    String?
  joinedAt       DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model OrganizationInvitation {
  invitationId   String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String   // admin | attorney | investigator | staff
  officeId       String?
  practiceGroupId String?
  practiceGroup  PracticeGroup? @relation(fields: [practiceGroupId], references: [practiceGroupId])
  tokenHash      String
  status         String   @default("pending") // pending | accepted | expired | revoked
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([tokenHash])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("organization_invitations")
}

model OrganizationDepartment {
  departmentId   String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  officeId       String?
  office         OrganizationOffice? @relation(fields: [officeId], references: [officeId])
  name           String
  description    String?

  members        OrganizationMember[]
  permissionGrants PermissionGrant[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([officeId])
  @@map("organization_departments")
}

model PersonnelProfile {
  profileId      String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personnelType  String   // attorney | investigator | paralegal | legal_assistant | office_admin | receptionist | expert_witness | contract_investigator
  jobTitle       String?
  barNumber      String?
  phone          String?
  bio            String?
  certifications Json?    // [{ name, issuer, issuedAt, expiresAt }]
  licenses       Json?    // [{ type, number, state, expiresAt }]
  permissions    Json?    // { canViewEvidence, canAssignCases, ... }
  calendarSettings Json?
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([personnelType])
  @@map("personnel_profiles")
}

model ClientTeamAssignment {
  assignmentId       String   @id @default(uuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  tenantId           String
  primaryAttorneyId  String?
  secondaryAttorneyId String?
  investigatorId     String?
  paralegalId        String?
  legalAssistantId   String?
  officeId           String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([primaryAttorneyId])
  @@index([officeId])
  @@map("client_team_assignments")
}

model OrgInternalMessage {
