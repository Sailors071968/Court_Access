# Court Access — Backend Environment Configuration
# Copy to .env and fill in real values

# Server
PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://courtaccess:courtaccess@localhost:5432/courtaccess

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=court-access-documents

# SES
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@courtaccess.net

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=

# File Upload
MAX_FILE_SIZE_MB=50
