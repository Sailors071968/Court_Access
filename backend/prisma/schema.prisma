model PermissionGrant {
  grantId        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  scope          String   // office | department | case | document | evidence | admin
  resourceId     String?
  departmentId   String?
  department     OrganizationDepartment? @relation(fields: [departmentId], references: [departmentId])
  permission     String   // view | edit | assign | approve | admin
  grantedById    String
  expiresAt      DateTime?

  createdAt      DateTime @default(now())

  @@index([organizationId, userId])
  @@index([scope, resourceId])
  @@map("permission_grants")
}

model ApprovalRequest {
  requestId      String   @id @default(uuid())
  organizationId String
  tenantId       String
  requestType    String   // case_assignment | document_release | billing | personnel
  resourceType   String
  resourceId     String
  requestedById  String
  approverId     String?
  status         String   @default("pending") // pending | approved | denied
  notes          String?
  decidedAt      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([tenantId, status])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
