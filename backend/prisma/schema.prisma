  agencyId        String?
  eventType       String    // EMAIL_SENT | EMAIL_RECEIVED | DOCUMENT_UPLOADED | POLICY_PARSED | POLICY_ACTIVE | FOLLOW_UP_SENT | REQUEST_CREATED
  title           String
  message         String
  metadata        String?   // JSON: additional event data
  read            Boolean   @default(false)
  dismissed       Boolean   @default(false)

  createdAt       DateTime  @default(now())

  @@index([agencyId])
  @@index([eventType])
  @@index([read])
  @@index([createdAt])
  @@map("cpra_notifications")
}

// ---------------------------------------------------------------------------
// Autonomous CPRA System — Agency Timeline Events
// ---------------------------------------------------------------------------

