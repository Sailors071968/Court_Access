# CourtAccess — environment for the PM2 / release deployment.
#
# Copy to the release root as .env — e.g. /var/www/courtaccess-v1/.env — and
# fill in every value under "Required". Node reads this file itself at every
# spawn via --env-file, so it is the single source of configuration for the
# running service.
#
# NOT the same file as deploy/.env.example. That one configures the Docker
# Compose stack, which synthesises DATABASE_URL from POSTGRES_* parts. Using it
# here produces a service that cannot start: the boot fails with
# "Database unreachable" and PM2 restarts it forever.
#
# This file is parsed by Node, which is not a shell. It does not honour an
# `export` prefix, does not expand ${VAR}, and does not run $(command). Write
# plain KEY=value only. stage3-start.sh refuses to deploy a file that breaks
# these rules, and reports which line.

# ---------------------------------------------------------------------------
# Required — the service will not start without all of these
# ---------------------------------------------------------------------------

# Anything other than "production" leaves cookies without the secure flag, and
# downgrades every fatal configuration error below to a warning.
NODE_ENV=production

# The port nginx proxies to. If these disagree, every request is a 502 while the
# process looks perfectly healthy.
PORT=3100

# nginx is the only client, so do not listen on 0.0.0.0.
HOST=127.0.0.1

# Prisma connection string. Keep ?schema=public — Prisma needs it.
# psql and pg_dump reject that parameter; strip it for them, not here.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/courtaccess_v1?schema=public

# Signs access and refresh tokens. At least 32 characters each.
# Generate: openssl rand -base64 48
# Changing either signs every user out.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Signs cookies. At least 32 characters. Generate: openssl rand -base64 32
# There is a fallback constant in the source; using it in production is not a
# secret, so the startup validator treats that as fatal.
COOKIE_SECRET=

# Evidence is written here. It MUST be outside the release directory — a
# deployment replaces that directory, and would destroy uploaded discovery.
EVIDENCE_UPLOAD_DIR=/var/lib/courtaccess/evidence

# ---------------------------------------------------------------------------
# Required for the certified configuration (no Redis deployed)
# ---------------------------------------------------------------------------

# "true" stops five BullMQ workers dialling a Redis that is not there. Without
# it they retry forever and bury real errors in the PM2 log.
DISABLE_WORKERS=true

# ---------------------------------------------------------------------------
# Optional — absence is handled, but each disables something
# ---------------------------------------------------------------------------

# Staging area for certification runs. Defaults to
# /var/tmp/courtaccess-certification-staging if unset.
CERTIFICATION_STAGING_DIR=/var/tmp/courtaccess-certification-staging

# Only set this if Redis is actually deployed, and then set DISABLE_WORKERS
# to false. Unset, the code defaults to redis://localhost:6379, so a host whose
# Redis lives elsewhere fails looking exactly like Redis being down.
# REDIS_URL=redis://HOST:6379

# Added to the CORS allow-list alongside the courtaccess.net origins.
# FRONTEND_URL=https://courtaccess.net

# Without these the corresponding features are inert rather than broken:
# AI analysis, CPRA email, attachment storage, billing.
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=cpra@courtaccess.net
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# LOG_LEVEL=info
