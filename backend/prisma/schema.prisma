  redactionId    String   @id @default(uuid())
  tenantId       String
  caseId         String
  documentId     String
  profileName    String
  versionNumber  Int      @default(1)
  s3KeyRedacted  String?
  status         String   @default("draft")
  createdById    String
  approvedById   String?
  redactionData  String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, caseId, documentId])
  @@index([profileName])
  @@map("document_redaction_versions")
}

// ---------------------------------------------------------------------------
// Program 1 — Disclosure manager (controlled publication packages)
// ---------------------------------------------------------------------------

model DisclosurePackage {
  packageId       String   @id @default(uuid())
  tenantId        String
  caseId          String
  documentId      String
  redactionId     String?
  recipientType   String
  recipientUserId String?
  recipientEmail  String?
  status          String   @default("draft")
  publishedById   String
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([recipientUserId])
  @@map("disclosure_packages")
}

// ---------------------------------------------------------------------------
// Program 6A — Publication Engine (document copies, sets, audit)
// ---------------------------------------------------------------------------

model DocumentCopy {
  copyId           String   @id @default(uuid())
  tenantId         String
  caseId           String
  documentId       String
  copyType         String   // original | working | redacted | publication
  s3Key            String?
  parentCopyId     String?
  redactionId      String?
  publicationSetId String?
  immutable        Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())

  @@index([tenantId, caseId, documentId])
  @@index([copyType])
  @@map("document_copies")
}

model PublicationSet {
  setId         String   @id @default(uuid())
  tenantId      String
  caseId        String
  name          String
  profileName   String
  status        String   @default("draft")
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  items         PublicationSetItem[]

  @@index([tenantId, caseId])
  @@map("publication_sets")
}

model PublicationSetItem {
  itemId            String   @id @default(uuid())
  setId             String
  set               PublicationSet @relation(fields: [setId], references: [setId], onDelete: Cascade)
  documentId        String
  redactionId       String?
  publicationCopyId String?

  @@index([setId])
  @@map("publication_set_items")
}

model PublicationAuditLog {
  auditId    String   @id @default(uuid())
  tenantId   String
  caseId     String
  action     String
  entityType String
  entityId   String
  actorId    String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([entityType, entityId])
  @@map("publication_audit_logs")
}
