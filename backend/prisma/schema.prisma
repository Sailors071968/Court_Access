// ---------------------------------------------------------------------------
// Core Evidence System — Evidence Metadata
// ---------------------------------------------------------------------------

model Evidence {
  evidenceId      String   @id @default(uuid())
  caseId          String
  case            CriminalCase @relation(fields: [caseId], references: [caseId])
  tenantId        String
  fileName        String
  mimeType        String?
  size            BigInt   @default(0)
  duration        Int?     // seconds, for video
  pageCount       Int?     // for documents
  evidenceType    String   // transcript | police_report | bodycam | dashcam | witness_video | photo | dispatch_log | forensic_report | autopsy_report | other_document
  s3Key           String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  // Processing status
  /** SHA-256 of the stored bytes. A document cited in a filing has to be
   *  provably the document that was produced, and a fingerprint is the only
   *  thing that shows the file has not changed since it was analysed. */
  sha256           String?
  processingStatus String  @default("pending") // pending | ingesting | normalized | analyzed | failed
  processingError  String?

  // Document normalization
  multiplexDetected Boolean @default(false)
  multiplexCount    Int?
  normalizedPageCount Int?

  // Page boundaries within the extracted text, as
  // [{ page, startOffset, endOffset }]. Lets any character offset in a chunk
  // or an extracted event be resolved back to a page and a line on that page,
  // which is what a citation in a brief has to name.
  pageMap          Json?

  // ACU compute preparation (Part 15)
  acuCost          Float?
  acuConsumed      Float    @default(0)
  analysisStatus   String   @default("pending") // pending | queued | processing | completed | failed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceType])
  @@index([processingStatus])
  @@index([analysisStatus])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// PR 3 — Evidence Chunks — Breaks large evidence into manageable pieces
// ---------------------------------------------------------------------------

model EvidenceChunk {
  id             String   @id @default(uuid())
  evidenceId     String
  tenantId       String
  chunkIndex     Int      // Zero-based ordering within the evidence
  text           String   // The chunk text content
  startOffset    Int      // Character offset in the original document
  endOffset      Int      // Character end offset in the original document
  checksum       String   // SHA-256 truncated to 16 hex chars
  charCount      Int      // Character count of this chunk

  createdAt      DateTime @default(now())

  @@unique([evidenceId, chunkIndex])
  @@index([evidenceId])
  @@index([tenantId])
  @@index([checksum])
  @@map("evidence_chunks")
}

