// Court Access — Backend Prisma Schema
// Manages corpus ingestion state, audit logs, and legal document storage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion State — checkpoint/resume system
// ---------------------------------------------------------------------------

model CorpusIngestionState {
  id                   String   @id @default(uuid())
  corpusName           String
  fileName             String
  lastProcessedOffset  Int      @default(0)
  recordsProcessed     Int      @default(0)
  totalRecords         Int?
  status               String   @default("pending") // pending | in_progress | completed | failed | paused
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([corpusName, fileName])
  @@index([corpusName])
  @@index([status])
  @@map("corpus_ingestion_state")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion Log — batch-level audit trail
// ---------------------------------------------------------------------------

model CorpusIngestionLog {
  id              String   @id @default(uuid())
  corpusName      String
  batchNumber     Int
  recordsInserted Int
  durationMs      Int
  status          String   // success | failed | skipped
  errorMessage    String?
  timestamp       DateTime @default(now())

  @@index([corpusName])
  @@index([timestamp])
  @@map("corpus_ingestion_log")
}

// ---------------------------------------------------------------------------
// Legal Document — normalized corpus storage
// ---------------------------------------------------------------------------

model LegalDocument {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  content         String
  jurisdiction    String
  documentType    String   // policy | statute | case_law | transcript | evidence | investigative_report
  source          String
  version         String   @default("1.0")
  corpusName      String?
  sourceFile      String?
  contentHash     String   // SHA-256 of content for dedup
  corpusVersion   String?  // Version of the corpus this document belongs to
  documentVersion String   @default("1.0") // Version of this specific document
  supersededBy    String?  // ID of the document that supersedes this one
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contentHash, tenantId])
  @@index([tenantId])
  @@index([documentType])
  @@index([corpusName])
  @@index([jurisdiction])
  @@index([contentHash])
  @@index([supersededBy])
  @@map("legal_documents")
}

// ---------------------------------------------------------------------------
// Corpus Registry — tracks all registered corpora and their versions
// ---------------------------------------------------------------------------

model CorpusRegistry {
  id               String   @id @default(uuid())
  corpusName       String
  jurisdiction     String
  sourceAuthority  String   // e.g. "California Legislature", "US Congress"
  version          String   @default("1.0")
  releaseDate      DateTime?
  ingestionStatus  String   @default("pending") // pending | in_progress | completed | failed
  totalDocuments   Int      @default(0)
  totalBytes       BigInt   @default(0)
  checksum         String?  // SHA-256 of the entire corpus file
  metadata         String?  // JSON string for extensible metadata
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([corpusName, version])
  @@index([corpusName])
  @@index([jurisdiction])
  @@index([ingestionStatus])
  @@map("corpus_registry")
}

// ---------------------------------------------------------------------------
// Corpus Ingestion Lock — prevents concurrent ingestion of the same corpus
// ---------------------------------------------------------------------------

model CorpusIngestionLock {
  id          String   @id @default(uuid())
  corpusName  String   @unique
  workerId    String
  lockedAt    DateTime @default(now())
  expiresAt   DateTime // Auto-expire to prevent deadlocks
  metadata    String?  // JSON string for worker info

  @@index([corpusName])
  @@index([expiresAt])
  @@map("corpus_ingestion_lock")
}

// ---------------------------------------------------------------------------
// API Provider — external API/AI integration registry
// ---------------------------------------------------------------------------

model ApiProvider {
  id               String          @id @default(uuid())
  name             String          @unique
  providerType     String          // AI_REASONING | AI_PRESENTATION | LEGAL_DATA | MEDIA_ANALYSIS | GRAPH | ANALYTICS
  baseUrl          String
  documentationUrl String?
  enabled          Boolean         @default(true)
  healthStatus     String          @default("unknown") // healthy | degraded | unhealthy | unknown
  lastHealthCheck  DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  credentials      ApiCredential[]
  usageLogs        ApiUsageLog[]

  @@index([providerType])
  @@index([enabled])
  @@index([healthStatus])
  @@map("api_providers")
}

// ---------------------------------------------------------------------------
// API Credential — encrypted credential storage per provider
// ---------------------------------------------------------------------------

model ApiCredential {
  id                String      @id @default(uuid())
  providerId        String
  apiKeyEncrypted   String      // AES-256 encrypted API key
  environment       String      @default("production") // production | staging | development
  rateLimitPerMinute Int        @default(60)
  lastValidatedAt   DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  provider          ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([environment])
  @@index([isActive])
  @@map("api_credentials")
}

// ---------------------------------------------------------------------------
// API Usage Log — request/response audit trail
// ---------------------------------------------------------------------------

model ApiUsageLog {
  id               String   @id @default(uuid())
  providerId       String
  endpointUsed     String
  requestTimestamp DateTime @default(now())
  responseStatus   Int      // HTTP status code or -1 for network error
  latencyMs        Int
  errorMessage     String?

  provider         ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([requestTimestamp])
  @@index([responseStatus])
  @@map("api_usage_logs")
}
