  version        String   @unique
  checksum       String
  appliedAt      DateTime @default(now())
  appliedBy      String   @default("prisma-migrate")
  description    String?
  migrationName  String
  driftChecked   Boolean  @default(false)

  @@index([appliedAt])
  @@map("schema_versions")
}

model Charge {
  id             String   @id @default(uuid())
  caseId         String
  case           CriminalCase @relation(fields: [caseId], references: [caseId])
  code           String   // e.g. "PC", "VC", "HSC"
  section        String   // e.g. "459", "23152(a)"
  title          String?
  dateOfOffense  DateTime?
  victim         String
  severity       String?  // felony | misdemeanor | wobbler | infraction
  createdAt      DateTime @default(now())

  calcrimInstructionId String?
  calcrimInstruction   CalcrimInstruction? @relation(fields: [calcrimInstructionId], references: [id])

  elementStatementLinks ElementStatementLink[]

  @@index([caseId])
  @@index([code, section])
  @@map("charges")
}

// ---------------------------------------------------------------------------
// Phase C.1 — CALCRIM Foundation: Prosecution Burden Schema
// ---------------------------------------------------------------------------

// CalcrimInstruction — represents a single CALCRIM jury instruction
model CalcrimInstruction {
  id                String   @id @default(uuid())
  instructionNumber Int      @unique // e.g. 1700 for Burglary
  title             String   // e.g. "Burglary (Pen. Code, § 459)"
  crimeCategory     String   // e.g. "crimes_against_property", "crimes_against_person"
  description       String?  // Full text summary of the instruction
  penalCode         String   // e.g. "PC 459"
  intentType        String   // "specific" | "general" | "strict_liability"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  elements          CalcrimElement[]
  charges           Charge[]

  @@index([instructionNumber])
  @@index([penalCode])
  @@index([crimeCategory])
  @@map("calcrim_instructions")
}

// CalcrimElement — ordered element within a CALCRIM instruction
model CalcrimElement {
  id                   String   @id @default(uuid())
  instructionId        String
  instruction          CalcrimInstruction @relation(fields: [instructionId], references: [id])
  elementNumber        Int      // Ordered position within instruction (1-based)
  label                String   // Short canonical label, e.g. "Entry into a structure"
  description          String   // Full element text as jury would hear it
  prosecutionBurden    String   // What prosecution must prove for this element
  isEssential          Boolean  @default(true)  // If false, element is alternative/enhancement
  weight               Float    @default(1.0)   // Relative importance (0.0-1.0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  aliases              ElementAlias[]
  keywords             ElementKeyword[]
  elementStatementLinks ElementStatementLink[]

  @@unique([instructionId, elementNumber])
  @@index([instructionId])
  @@map("calcrim_elements")
}

// ElementAlias — alternate phrasings for an element
model ElementAlias {
  id          String   @id @default(uuid())
  elementId   String
  element     CalcrimElement @relation(fields: [elementId], references: [id])
  alias       String   // e.g. "broke into", "gained entry", "trespassed"
  source      String   @default("manual") // manual | case_law | statute

  createdAt   DateTime @default(now())

  @@index([elementId])
  @@index([alias])
  @@map("element_aliases")
}

// ElementKeyword — searchable keywords for deterministic matching
model ElementKeyword {
  id          String   @id @default(uuid())
  elementId   String
  element     CalcrimElement @relation(fields: [elementId], references: [id])
  keyword     String   // Single keyword or short phrase
  category    String   @default("action") // action | target | state | qualifier
  weight      Float    @default(1.0)  // Match weight (higher = stronger signal)

  createdAt   DateTime @default(now())

  @@index([elementId])
  @@index([keyword])
  @@index([category])
  @@map("element_keywords")
}

// ---------------------------------------------------------------------------
// Phase D.1 — Evidence Document (source document metadata)
// ---------------------------------------------------------------------------

model EvidenceDocument {
  id               String   @id @default(uuid())
  caseId           String
  tenantId         String
  evidenceId       String?  // FK to Evidence table if applicable
  fileName         String
  fileType         String   // pdf | transcript | bodycam_transcript | dispatch_log | witness_statement | interrogation
  documentType     String   // police_report | transcript | bodycam | interrogation | dispatch | witness_statement
  totalPages       Int      @default(0)
  totalLines       Int      @default(0)
  totalStatements  Int      @default(0)
  processingStatus String   @default("pending") // pending | processing | completed | failed
  errorMessage     String?
  hash             String?  // SHA-256 of original content for dedup

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pages            EvidencePage[]
  statements       EvidenceStatement[]

  @@index([caseId])
  @@index([tenantId])
  @@index([evidenceId])
  @@index([documentType])
  @@index([processingStatus])
  @@map("evidence_documents")
}

// ---------------------------------------------------------------------------
// Phase D.1 — Evidence Page (per-page metadata for source documents)
// ---------------------------------------------------------------------------

model EvidencePage {
  id               String   @id @default(uuid())
  documentId       String
  document         EvidenceDocument @relation(fields: [documentId], references: [id])
  pageNumber       Int      // 1-based
  totalLines       Int      @default(0)
  rawContent       String   // Full raw text of this page
  contentHash      String?  // SHA-256 of page content

  createdAt        DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("evidence_pages")
}

// ---------------------------------------------------------------------------
// Phase C.2/D.1 — Evidence Statement (normalized source text segments)
// ---------------------------------------------------------------------------

model EvidenceStatement {
  id                   String   @id @default(uuid())
  caseId               String
  tenantId             String
  sourceDocumentId     String   // Evidence.evidenceId or EvidenceDocument.id
  documentId           String?  // FK to EvidenceDocument
  document             EvidenceDocument? @relation(fields: [documentId], references: [id])
  page                 Int?     // Source page number (1-based)
  lineStart            Int?     // Starting line in source
  lineEnd              Int?     // Ending line in source
  paragraphIndex       Int?     // Paragraph number within page (0-based)
  timestamp            String?  // Timestamp within source (e.g. bodycam timecode)
  speaker              String?  // Who said/wrote this
  rawText              String   // Verbatim extracted text — NEVER modified
  normalizedText       String   // Cleaned but not summarized text
  exactText            String?  // Identical to rawText — preserved for courtroom defensibility
  extractionConfidence Float    @default(1.0) // 0.0-1.0
  extractionMethod     String   @default("manual") // manual | ocr | transcript_parse | pdf_extract | dispatch_parse | witness_parse
  statementType        String   @default("narrative") // narrative | question | answer | temporal | directive | observation
  hash                 String?  // SHA-256 of rawText for dedup/integrity

  createdAt            DateTime @default(now())

  elementStatementLinks ElementStatementLink[]
  citations             StatementCitation[]
  speakers              StatementSpeaker[]
  timestamps            StatementTimestamp[]

  @@index([caseId])
  @@index([tenantId])
  @@index([sourceDocumentId])
  @@index([documentId])
  @@index([speaker])
  @@index([statementType])
  @@index([hash])
  @@map("evidence_statements")
}

// ---------------------------------------------------------------------------
// Phase D.1 — Statement Citation (exact source references)
// ---------------------------------------------------------------------------

model StatementCitation {
  id               String   @id @default(uuid())
  statementId      String
  statement        EvidenceStatement @relation(fields: [statementId], references: [id])
  citationType     String   // page | line_range | paragraph | exhibit | bates_number
  pageNumber       Int?
  lineStart        Int?
  lineEnd          Int?
  paragraphIndex   Int?
  exhibitRef       String?  // e.g. "Exhibit A", "People's 1"
  batesNumber      String?  // Bates stamp reference
  rawReference     String   // Original citation text as it appears in source

  createdAt        DateTime @default(now())

  @@index([statementId])
  @@index([citationType])
  @@map("statement_citations")
}

// ---------------------------------------------------------------------------
// Phase D.1 — Statement Speaker (attributed speaker metadata)
// ---------------------------------------------------------------------------

model StatementSpeaker {
  id               String   @id @default(uuid())
  statementId      String
  statement        EvidenceStatement @relation(fields: [statementId], references: [id])
  speakerName      String   // Detected speaker name/label
  speakerRole      String?  // officer | witness | defendant | prosecutor | judge | unknown
  speakerConfidence Float   @default(1.0) // How confident the attribution is
  detectionMethod  String   @default("pattern") // pattern | header | explicit_label | inferred

  createdAt        DateTime @default(now())

  @@index([statementId])
  @@index([speakerName])
  @@index([speakerRole])
  @@map("statement_speakers")
}

// ---------------------------------------------------------------------------
// Phase D.1 — Statement Timestamp (temporal references within statements)
// ---------------------------------------------------------------------------

model StatementTimestamp {
  id               String   @id @default(uuid())
  statementId      String
  statement        EvidenceStatement @relation(fields: [statementId], references: [id])
  rawTimestamp      String   // Exact timestamp text from source
  normalizedTime   String?  // ISO 8601 or HH:MM:SS normalized form
  timestampType    String   @default("event") // event | bodycam | dispatch | statement_time | narrative
  confidence       Float    @default(1.0)

  createdAt        DateTime @default(now())

  @@index([statementId])
  @@index([timestampType])
  @@map("statement_timestamps")
}

// ---------------------------------------------------------------------------
// Phase C.3 — Element-Statement Link (maps statements to CALCRIM elements)
// ---------------------------------------------------------------------------

model ElementStatementLink {
  id                String   @id @default(uuid())
  statementId       String
  statement         EvidenceStatement @relation(fields: [statementId], references: [id])
  elementId         String
  element           CalcrimElement @relation(fields: [elementId], references: [id])
  chargeId          String
  charge            Charge @relation(fields: [chargeId], references: [id])

  matchMethod       String   @default("keyword") // keyword | alias | rule_engine | manual
  confidence        Float    @default(0.0) // 0.0-1.0
  supportType       String   @default("supports") // supports | contradicts | neutral
  matchedKeywords   String?  // JSON array of matched keywords
  explanation       String?  // Why this link exists

  createdAt         DateTime @default(now())

  @@unique([statementId, elementId, chargeId])
  @@index([statementId])
  @@index([elementId])
  @@index([chargeId])
  @@index([supportType])
  @@map("element_statement_links")
}

// ---------------------------------------------------------------------------
// Phase D.2 — CALCRIM Element Mapping (statement → instruction → element)
// ---------------------------------------------------------------------------

model CalcrimElementMapping {
  id                    String   @id @default(uuid())
  statementId           String
  instructionId         String
  elementId             String
  confidence            Float    @default(0.0) // 0.0-1.0
  mappingMethod         String   @default("lexical") // lexical | phrase | ontology | keyword | regex | manual
  lexicalTriggers       String?  // JSON array of matched terms
  semanticCategory      String?  // act | intent | knowledge | identity | temporal | impeachment | contradiction | credibility | procedural
  prosecutorTheoryWeight Float   @default(0.0) // 0.0-1.0 relevance to prosecution theory
  evidenceClassification String  @default("act") // act | intent | knowledge | identity | temporal | impeachment | contradiction | credibility | procedural

  createdAt             DateTime @default(now())

  @@index([statementId])
  @@index([instructionId])
  @@index([elementId])
  @@index([semanticCategory])
  @@index([evidenceClassification])
  @@index([confidence])
  @@map("calcrim_element_mappings")
}

// ---------------------------------------------------------------------------
// Phase D.2 — Prosecutor Narrative Cluster
// ---------------------------------------------------------------------------

model CalcrimNarrativeCluster {
  id                String   @id @default(uuid())
  caseId            String
  instructionId     String
  narrativeType     String   // burden_proof | timeline | witness_account | physical_evidence | circumstantial
  prosecutionTheory String?  // Prosecution's theory of the case for this cluster
  confidence        Float    @default(0.0)
  totalStatements   Int      @default(0)
  elementsCovered   String?  // JSON array of element IDs covered by this cluster

  createdAt         DateTime @default(now())

  clusterStatements NarrativeClusterStatement[]

  @@index([caseId])
  @@index([instructionId])
  @@index([narrativeType])
  @@map("calcrim_narrative_clusters")
}

// ---------------------------------------------------------------------------
// Phase D.2 — Narrative Cluster ↔ Statement link
// ---------------------------------------------------------------------------

model NarrativeClusterStatement {
  id               String   @id @default(uuid())
  clusterId        String
  cluster          CalcrimNarrativeCluster @relation(fields: [clusterId], references: [id])
  statementId      String
  relevanceScore   Float    @default(0.0) // 0.0-1.0

  createdAt        DateTime @default(now())

  @@unique([clusterId, statementId])
  @@index([clusterId])
  @@index([statementId])
  @@map("narrative_cluster_statements")
}

// ---------------------------------------------------------------------------
// Phase D.3 — Contradiction Pair (proven factual incompatibility)
// ---------------------------------------------------------------------------

model ContradictionPair {
  id                    String   @id @default(uuid())
  caseId                String
  statementAId          String
  statementBId          String
  contradictionType     String   // factual | temporal | identity | procedural | witness | cross_document
  severity              String   // critical | high | medium | low
  elementId             String?  // CALCRIM element this contradiction affects
  instructionId         String?  // CALCRIM instruction
  proofMethod           String   // lexical_negation | temporal_impossibility | speaker_conflict | factual_exclusion | numeric_inconsistency | location_conflict
  proofExplanation      String   // Deterministic explanation of WHY these statements are incompatible
  statementAText        String   // Exact text of statement A
  statementBText        String   // Exact text of statement B
  statementAPage        Int?
  statementALineStart   Int?
  statementALineEnd     Int?
  statementASpeaker     String?
  statementADocumentId  String?
  statementBPage        Int?
  statementBLineStart   Int?
  statementBLineEnd     Int?
  statementBSpeaker     String?
  statementBDocumentId  String?
  confidence            Float    @default(0.0)
  burdenImpact          String?  // How this affects prosecution burden

  createdAt             DateTime @default(now())

  @@unique([statementAId, statementBId, contradictionType])
  @@index([caseId])
  @@index([contradictionType])
  @@index([severity])
  @@index([elementId])
  @@index([instructionId])
  @@map("contradiction_pairs")
}

// ---------------------------------------------------------------------------
// Phase D.3 — Burden Fracture (unsupported CALCRIM element chain)
// ---------------------------------------------------------------------------

model BurdenFracture {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String
  elementId           String
  fractureType        String   // unsupported | contradicted | weak_only | missing_corroboration | single_source
  severity            String   // critical | high | medium | low
  supportingCount     Int      @default(0)
  contradictingCount  Int      @default(0)
  averageConfidence   Float    @default(0.0)
  explanation         String   // Deterministic explanation of burden failure
  prosecutionImpact   String   // Element cannot be proven | Element weakened | Element disputed

  createdAt           DateTime @default(now())

  @@unique([caseId, elementId, fractureType])
  @@index([caseId])
  @@index([instructionId])
  @@index([elementId])
  @@index([fractureType])
  @@index([severity])
  @@map("burden_fractures")
}

// ---------------------------------------------------------------------------
// Phase D.3 — Witness Inconsistency (same speaker, conflicting statements)
// ---------------------------------------------------------------------------

model WitnessInconsistency {
  id                  String   @id @default(uuid())
  caseId              String
  speaker             String
  statementAId        String
  statementBId        String
  inconsistencyType   String   // factual_change | detail_shift | omission | addition | chronology_change | severity_change
  statementAText      String
  statementBText      String
  statementAPage      Int?
  statementADocumentId String?
  statementBPage      Int?
  statementBDocumentId String?
  detectedPattern     String   // The specific lexical/temporal pattern that proves inconsistency
  credibilityImpact   String   // high | medium | low
  explanation         String

  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([speaker])
  @@index([inconsistencyType])
  @@map("witness_inconsistencies")
}

// ---------------------------------------------------------------------------
// Phase D.3 — Timeline Incompatibility (temporal impossibility)
// ---------------------------------------------------------------------------

model TimelineIncompatibility {
  id                  String   @id @default(uuid())
  caseId              String
  statementAId        String
  statementBId        String
  incompatibilityType String   // simultaneous_different_location | impossible_sequence | duration_conflict | before_after_reversal
  timestampA          String?
  timestampB          String?
  locationA           String?
  locationB           String?
  statementAText      String
  statementBText      String
  statementAPage      Int?
  statementBPage      Int?
  statementASpeaker   String?
  statementBSpeaker   String?
  explanation         String
  severity            String   // critical | high | medium | low

  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([incompatibilityType])
  @@index([severity])
  @@map("timeline_incompatibilities")
}

// ---------------------------------------------------------------------------
// Phase D.3 — Prosecutor Theory Attack Surface
// ---------------------------------------------------------------------------

model ProsecutorTheoryAttack {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String
  elementId           String?
  attackType          String   // burden_failure | contradiction_cluster | witness_unreliability | timeline_impossibility | missing_corroboration | theory_fracture
  severity            String   // critical | high | medium | low
  description         String   // Deterministic description of the attack surface
  supportingEvidence  String   // JSON array of { contradictionPairId?, burdenFractureId?, witnessInconsistencyId?, timelineIncompatibilityId? }
  prosecutionWeakness String   // Specific prosecution burden weakness
  defenseOpportunity  String   // Specific defense argument opportunity

  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([instructionId])
  @@index([attackType])
  @@index([severity])
  @@map("prosecutor_theory_attacks")
}

// ---------------------------------------------------------------------------
// Phase D.4 — Defense Issue (prioritized defense opportunity)
// ---------------------------------------------------------------------------

model DefenseIssue {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String?
  elementId           String?
  issueType           String   // burden_failure | contradiction | witness_credibility | timeline_impossibility | procedural_defect | missing_corroboration | theory_fracture
  priority            Int      @default(0) // 1=highest, computed deterministically
  severity            String   // critical | high | medium | low
  title               String
  description         String
  legalBasis          String   // Specific CALCRIM element / procedural rule
  supportingIds       String   // JSON array of source IDs (contradictionPairId, burdenFractureId, etc.)
  citationCount       Int      @default(0)
  prosecutionImpact   String
  defenseAction       String   // Recommended defense action (deterministic, not advice)
  status              String   @default("open") // open | reviewed | incorporated | dismissed

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([caseId])
  @@index([priority])
  @@index([severity])
  @@index([issueType])
  @@index([status])
  @@map("defense_issues")
}

// ---------------------------------------------------------------------------
// Phase D.4 — Motion Opportunity (citation-backed motion basis)
// ---------------------------------------------------------------------------

model MotionOpportunity {
  id                  String   @id @default(uuid())
  caseId              String
  motionType          String   // directed_verdict | suppress_evidence | dismiss_count | impeach_witness | exclude_testimony | reconsider_bail | mistrial_basis
  title               String
  legalBasis          String   // Statutory / CALCRIM basis
  factualBasis        String   // Specific citations proving motion grounds
  supportingIds       String   // JSON array of source IDs
  citationSummary     String   // Concatenated page/line citations
  strength            String   // strong | moderate | weak
  priority            Int      @default(0)
  status              String   @default("identified") // identified | drafted | filed | ruled

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([caseId])
  @@index([motionType])
  @@index([strength])
  @@index([priority])
  @@map("motion_opportunities")
}

// ---------------------------------------------------------------------------
// Phase D.4 — Impeachment Packet (per-witness impeachment materials)
// ---------------------------------------------------------------------------

model ImpeachmentPacket {
  id                  String   @id @default(uuid())
  caseId              String
  witnessName         String
  totalInconsistencies Int     @default(0)
  totalContradictions  Int     @default(0)
  credibilityScore    Float    @default(1.0) // 0.0-1.0, lower = less credible
  impeachmentItems    String   // JSON array of { type, statementAId, statementBId, statementAText, statementBText, page, explanation }
  crossExamTopics     String   // JSON array of suggested cross-exam topic areas (deterministic, from evidence)
  priorStatementConflicts String // JSON array of { priorText, trialText, page, line }

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([caseId, witnessName])
  @@index([caseId])
  @@index([witnessName])
  @@index([credibilityScore])
  @@map("impeachment_packets")
}

// ---------------------------------------------------------------------------
// Phase D.4 — Burden Collapse Score (per-instruction burden assessment)
// ---------------------------------------------------------------------------

model BurdenCollapseScore {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String
  instructionNumber   Int
  totalElements       Int      @default(0)
  unsupportedElements Int      @default(0)
  contradictedElements Int     @default(0)
  weakElements        Int      @default(0)
  strongElements      Int      @default(0)
  collapseScore       Float    @default(0.0) // 0.0-1.0, higher = more collapsed
  collapseLevel       String   // collapsed | fractured | weakened | supported
  explanation         String
  elementDetails      String   // JSON array of { elementId, label, status, supportCount, contradictionCount, confidence }

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([caseId, instructionId])
  @@index([caseId])
  @@index([collapseScore])
  @@index([collapseLevel])
  @@map("burden_collapse_scores")
}

// ---------------------------------------------------------------------------
// Phase D.4 — Jury Reasonable Doubt Structure (evidence-backed doubt)
// ---------------------------------------------------------------------------

model JuryReasonableDoubtStructure {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String?
  doubtCategory       String   // burden_gap | witness_contradiction | timeline_impossibility | missing_evidence | procedural_violation | expert_conflict
  title               String
  narrative           String   // Factual narrative of doubt (citation-backed, deterministic)
  supportingCitations String   // JSON array of { text, page, line, speaker, document }
  strength            String   // compelling | significant | moderate | marginal
  juryInstruction     String?  // Related CALCRIM jury instruction text

  createdAt           DateTime @default(now())

  @@index([caseId])
  @@index([doubtCategory])
  @@index([strength])
  @@map("jury_reasonable_doubt_structures")
}

// ---------------------------------------------------------------------------
// Phase D.5 — Trial Exhibit (citation-linked exhibit for court use)
// ---------------------------------------------------------------------------

model TrialExhibit {
  id                  String   @id @default(uuid())
  caseId              String
  exhibitNumber       String
  exhibitType         String   // contradiction | impeachment | timeline | burden_failure | witness_attack | evidence_summary
  title               String
  description         String
  content             String   // Structured exhibit content (JSON)
  citations           String   // JSON array of { text, page, line, speaker, document }
  relatedIds          String   // JSON array of source IDs
  status              String   @default("draft") // draft | finalized | filed
  generatedAt         DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([caseId, exhibitNumber])
  @@index([caseId])
  @@index([exhibitType])
  @@index([status])
  @@map("trial_exhibits")
}

// ---------------------------------------------------------------------------
// Phase D.5 — Witness Attack Sheet (per-witness trial prep)
// ---------------------------------------------------------------------------

model WitnessAttackSheet {
  id                    String   @id @default(uuid())
  caseId                String
  witnessName           String
  credibilityScore      Float    @default(1.0)
  inconsistencySummary  String   // JSON array of { topic, statementA, statementB, page, impact }
  contradictionSummary  String   // JSON array of { topic, proofMethod, stmtA, stmtB, page }
  crossExamTopics       String   // JSON array of ordered cross-exam topic areas
  impeachmentSequence   String   // JSON array of ordered impeachment steps
  priorStatements       String   // JSON array of { document, page, text }
  keyQuotations         String   // JSON array of { text, page, line, significance }
  timelineConflicts     String   // JSON array of { timestampA, timestampB, explanation }
  overallAssessment     String   // Deterministic witness reliability assessment

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([caseId, witnessName])
  @@index([caseId])
  @@index([witnessName])
  @@map("witness_attack_sheets")
}

// ---------------------------------------------------------------------------
// Phase D.5 — CALCRIM Failure Matrix (element-by-element prosecution failure)
// ---------------------------------------------------------------------------

model CalcrimFailureMatrix {
  id                  String   @id @default(uuid())
  caseId              String
  instructionId       String
  instructionNumber   Int
  chargeTitle         String
  totalElements       Int      @default(0)
  elementAnalysis     String   // JSON array of { elementId, label, status, supportCount, contradictionCount, confidence, citations }
  overallStatus       String   // collapsed | fractured | weakened | supported
  prosecutionGaps     String   // JSON array of specific prosecution failures
  defenseArguments    String   // JSON array of element-specific defense arguments (citation-backed)
  motionBasis         String?  // If applicable: statutory motion basis

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([caseId, instructionId])
  @@index([caseId])
  @@index([overallStatus])
  @@map("calcrim_failure_matrices")
}

// ---------------------------------------------------------------------------
// Phase D.5 — Hearing Prep Packet
// ---------------------------------------------------------------------------

model HearingPrepPacket {
  id                  String   @id @default(uuid())
  caseId              String
  hearingType         String   // preliminary | suppression | trial | sentencing | bail
  title               String
  keyIssues           String   // JSON array of { issue, priority, citations }
  witnessOrder        String   // JSON array of { witness, purpose, attackSheet }
  exhibitList         String   // JSON array of { exhibitNumber, title, purpose }
  motionsSummary      String   // JSON array of { motionType, strength, basis }
  contradictionHighlights String // JSON array of top contradictions for this hearing
  burdenAnalysis      String   // JSON summary of burden status per instruction
  timelineIssues      String   // JSON array of timeline problems to raise

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([caseId])
  @@index([hearingType])
  @@map("hearing_prep_packets")
}

// ---------------------------------------------------------------------------
// Phase D.5 — Trial Notebook (assembled trial preparation package)
// ---------------------------------------------------------------------------

model TrialNotebook {
  id                  String   @id @default(uuid())
  caseId              String
  title               String
  sections            String   // JSON array of { sectionName, sectionType, content, citations }
  exhibitIndex        String   // JSON array of { exhibitNumber, title, type }
  witnessIndex        String   // JSON array of { name, role, attackSheetId }
  motionIndex         String   // JSON array of { motionType, title, strength }
  contradictionIndex  String   // JSON array of { id, type, severity }
  burdenSummary       String   // JSON overall burden analysis
  timelineSummary     String   // JSON timeline analysis
