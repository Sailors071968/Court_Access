# Court Access — Backend Environment Configuration
# Copy to .env and fill in real values

# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://courtaccess:courtaccess@localhost:5432/courtaccess

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=court-access-documents

# AWS SES
SES_FROM_EMAIL=noreply@courtaccess.net

# OpenAI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Upload
MAX_FILE_SIZE_MB=50
